# Hosted libSQL / Turso database. Recommended for production.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-token

# Fallback local database when the Turso variables above are not set.
# DATABASE_PATH=./data/ayovira.db

# Used for canonical links, sitemap, robots and structured data.
# NEXT_PUBLIC_SITE_URL=https://www.ayovira.site

# Optional Google Search Console verification token.
# GOOGLE_SITE_VERIFICATION=your-token
